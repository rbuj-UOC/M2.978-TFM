% --- ENTRADAS NORMALES (GLOSARIO) ---
@entry{CBM,
  name        = {Mantenimiento basado en la condición},
  description = {Enfoque de mantenimiento que se basa en la monitorización continua del estado de los equipos para tomar decisiones de mantenimiento en función de su condición actual.}
}

@entry{dataprep,
  name        = {Dataprep},
  description = {Biblioteca de Python para la preparación y limpieza de datos, que facilita la exploración, visualización y transformación de datos antes de su análisis o modelado.}
}

@entry{anai,
  name        = {Anai},
  description = {Biblioteca de Python para la construcción y evaluación de modelos de aprendizaje automático, que permite automatizar el proceso de selección de algoritmos, ajuste de hiperparámetros y validación cruzada.}
}

@entry{dt,
  name        = {Árboles de decisión},
  description = {Modelo de aprendizaje automático que utiliza un árbol de decisión para tomar decisiones basadas en características de entrada. Un árbol de decisión es una estructura de árbol donde cada nodo interno representa una característica, cada rama representa una regla de decisión y cada hoja representa un resultado o clase.}
}

@entry{edgecomputing,
  name        = {Edge Computing},
  description = {Enfoque de procesamiento de datos que consiste en ejecutar aplicaciones y servicios cerca de la fuente de los datos, en lugar de enviarlos a un centro de datos remoto.}
}

@entry{especificidad,
  name        = {Especificidad},
  description = {Proporción de instancias negativas que son correctamente identificadas por el modelo.}
}

@entry{exactitud,
  name        = {Exactitud},
  description = {Proporción de predicciones correctas sobre el total de instancias.}
}

@entry{exhaustividad,
  name        = {Exhaustividad},
  description = {Proporción de instancias positivas que son correctamente identificadas por el modelo.}
}

@entry{i40,
  name        = {Industria 4.0},
  description = {Era de la industria caracterizada por la digitalización y automatización de los procesos productivos, con el uso intensivo de tecnologías como IoT, IA y big data.}
}

@entry{kappa,
  name        = {Kappa},
  description = {Coeficiente kappa de Cohen, que mide la concordancia entre dos evaluadores más allá de lo que se esperaría por azar.}
}

@entry{ml,
  name        = {Aprendizaje automático},
  description = {Rama de la inteligencia artificial que se centra en el desarrollo de algoritmos que permiten a las máquinas aprender de los datos}
}

@entry{PdM,
  name        = {Mantenimiento Predictivo},
  description = {Enfoque de mantenimiento que utiliza datos y modelos estadísticos para predecir cuándo se producirá un fallo en un equipo o sistema.}
}

@entry{PM,
  name        = {Mantenimiento Preventivo},
  description = {Enfoque de mantenimiento que se realiza de manera programada y periódica para prevenir fallos y mantener el equipo en buen estado de funcionamiento.}
}

@entry{precisión,
  name        = {Precisión},
  description = {Proporción de predicciones correctas sobre el total de predicciones realizadas.}
}

@entry{RedesNeuronales,
  name        = {Redes Neuronales},
  description = {Modelo de aprendizaje automático que simula el funcionamiento del cerebro humano para procesar información y aprender de ella.}
}

@entry{RedesNeuronalesConvolucionales,
  name        = {Redes Neuronales Convolucionales},
  description = {Tipo de red neuronal que utiliza capas convolucionales para procesar datos con estructura de cuadrícula, como imágenes, y extraer características relevantes para tareas de clasificación o detección.}
}

@entry{RUL,
  name        = {Vida útil restante},
  description = {Tiempo que queda antes de que un equipo o sistema falle, basado en su estado actual y el historial de fallos.}
}

@entry{RandomForest,
  name        = {Random Forest},
  description = {Método de aprendizaje automático que combina múltiples árboles de decisión para mejorar la precisión y reducir el sobreajuste.}
}

@entry{transformer,
  name        = {Transformer},
  description = {Arquitectura de redes neuronales que utiliza mecanismos de atención para procesar secuencias de datos, permitiendo capturar dependencias a larga distancia y mejorando el rendimiento en tareas de procesamiento del lenguaje natural y visión por computador.}
}

@entry{weibull,
  name        = {Distribución de Weibull},
  description = {En teoría de la probabilidad y en estadística, la distribución de Weibull es una distribución de probabilidad continua. Se utiliza ampliamente en análisis de confiabilidad y modelado de fallos, ya que puede representar diferentes tipos de tasas de fallo dependiendo de sus parámetros.}
}

@entry{XGBoost,
  name        = {XGBoost},
  description = {Algoritmo de aprendizaje automático basado en árboles de decisión que utiliza un enfoque de optimización por gradientes para mejorar el rendimiento de los modelos.}
}
